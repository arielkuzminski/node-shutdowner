{
  "name": "shutdowner",
  "version": "2.0.0",
  "description": "Odlicza podany czas i wyłącza komputer — w terminalu albo w przeglądarce (Windows, Linux, macOS, WSL).",
  "type": "module",
  "bin": {
    "shutdowner": "src/cli.ts"
  },
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node src/cli.ts",
    "gui": "node src/cli.ts --gui",
    "gui:dry": "node src/cli.ts --gui --dry-run",
    "test": "node --test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.3",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0"
  }
}
